# RescueLink Pilot Environment Configuration Example
# Copy this file to .env and fill in strong locally generated secrets.
# DO NOT commit .env to version control.

# Application Mode (pilot / production / development / demo)
APP_MODE=pilot

# Node Environment (development / production)
NODE_ENV=development

# Server Port
PORT=5000

# JWT Cryptographic Signing Keys (Must be at least 32 characters in pilot/production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rescuelink
DB_USER=postgres
DB_PASSWORD=your_password

# Redis Cache and Socket Coordinator
REDIS_URL=redis://localhost:6379

# Twilio API Integration (SMS and WhatsApp alerts)
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Firebase Admin SDK Configuration (Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Google Maps Platform API Key (Directions + Traffic layers)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Razorpay Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ABDM National Gateway Credentials
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in

# Daily.co WebRTC Video Telemedicine Key
DAILY_CO_API_KEY=your_daily_co_key

# Application-layer PII/PHI Encryption Key (Must be at least 32 characters in pilot/production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_SECRET_MIN_32_CHARS

# Production CORS Allowlists
PRODUCTION_URL=https://staging.rescuelink.in
FRONTEND_URL=https://staging.rescuelink.in
