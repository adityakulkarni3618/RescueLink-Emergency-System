# URL of the running backend server.
# For local backend: http://localhost:5000
# For shared/exposed backend (e.g. via ngrok): https://<your-ngrok-subdomain>.ngrok-free.app
REACT_APP_API_URL=http://localhost:5000

# Optional: Specific URL for WebSockets (defaults to REACT_APP_API_URL if not provided)
REACT_APP_SOCKET_URL=http://localhost:5000
